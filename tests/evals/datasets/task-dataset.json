{
  "name": "task-management-dataset",
  "description": "Test cases for task management agent",
  "version": "1.0.0",
  "items": [
    {
      "id": "task-001",
      "input": {
        "query": "Create a task to review the project proposal"
      },
      "groundTruth": {
        "expectedTools": ["create_task"],
        "expectedStatus": "pending"
      }
    },
    {
      "id": "task-002",
      "input": {
        "query": "Create a high priority task to fix the login bug"
      },
      "groundTruth": {
        "expectedTools": ["create_task"],
        "expectedPriority": "high"
      }
    },
    {
      "id": "task-003",
      "input": {
        "query": "Schedule a daily standup meeting task"
      },
      "groundTruth": {
        "expectedTools": ["create_task", "schedule_task"]
      }
    }
  ]
}
