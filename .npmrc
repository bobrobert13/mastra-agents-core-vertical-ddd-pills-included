# ─────────────────────────────────────────────────────────────────────────────
# Configuración de npm para todo el repo.
#
# `legacy-peer-deps` ya era un requisito documentado (@mastra/evals tiene a
# vitest como peer), pero solo vivía en el README y en el env de CI: un
# `npm install` a secas fallaba. Declararlo aquí convierte la regla en real, y
# además @mastra/deployer copia este fichero a `.mastra/output` antes de sus dos
# ejecuciones de npm (Bundler.copyDOTNPMRC), así que el build también lo hereda.
legacy-peer-deps=true

# El build instala dos veces dentro de .mastra/output; ahí el ruido de audit y
# fund no es accionable.
audit=false
fund=false

# La caché primero. `Bundler.generateNpmLockfile` ejecuta
# `npm install --package-lock-only --force` con un timeout DURO de 60 s y un
# `catch {}` mudo: si no termina a tiempo, el build avisa "Failed to generate
# package-lock.json" aunque el lockfile del paso anterior sea válido. Como
# `--force` ya descarta la reutilización local del árbol, preferir la caché es la
# única palanca que queda sin parchear el deployer.
prefer-offline=true
