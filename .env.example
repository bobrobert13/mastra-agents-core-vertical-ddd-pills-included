# Environment — every variable is optional; the app boots with zero configuration.

# === Model providers (set at least one to use agents) ===
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# === Model selection (provider/model-id; precedence: MODEL_<AGENT> > MODEL > DEFAULT_MODEL) ===
MODEL=
MODEL_RESEARCH=
MODEL_TASKS=
MODEL_FILES=
DEFAULT_MODEL=

# === Storage (default: LibSQL file:./mastra.db) ===
DATABASE_URL=
LIBSQL_URL=

# === Vectors / semantic recall / RAG (off unless EMBEDDING_MODEL is set) ===
EMBEDDING_MODEL=
SEMANTIC_RECALL=

# === Auth (Server & Studio) ===
MASTRA_JWT_SECRET=
MASTRA_WORKER_AUTH_TOKEN=
AUTH_DISABLED=false

# === HTTP surface ===
CORS_ORIGIN=

# === Server ===
MASTRA_HOST=0.0.0.0
MASTRA_PORT=4111
MASTRA_WORKERS=
MASTRA_STEP_EXECUTION_URL=

# === Observability ===
LOG_LEVEL=info
SERVICE_NAME=mastra-boilerplate
ENABLE_OBSERVABILITY=true
ENABLE_TRACING=true

# === Workspace (native file tools; paths are contained to this root) ===
WORKSPACE_ROOT=./workspace

# === Deep-research HITL ===
REVIEW_APPROVAL=

# === Guardrails (LLM detectors mount only when SECURITY_PROCESSORS=active and a provider key is set) ===
SECURITY_PROCESSORS=
SECURITY_MODEL=
TOKEN_LIMIT=8000

# === MCP (inbound client / outbound server) ===
MCP_SERVERS=
ENABLE_MCP_SERVER=

# === Docker Compose database settings (used by docker/docker-compose.yml) ===
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
