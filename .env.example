# =====================================================
# Everything below is OPTIONAL. The app starts with zero
# configuration (LibSQL local file + no external services).
# Set a variable to activate the corresponding service —
# startup logs show which services are active.
# =====================================================

# === Model Providers (set at least one to use agents) ===
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# === Model Selection (optional — provider-agnostic, "provider/model-id" format) ===
# Precedence: MODEL_<AGENT> > MODEL > DEFAULT_MODEL (built-in: openai/gpt-4o-mini)
# Set MODEL to switch every agent at once, or per-agent vars to mix providers.
# MODEL=deepinfra/deepseek-ai/DeepSeek-V4-Flash-0731
# MODEL_RESEARCH=anthropic/claude-sonnet-4-5
# MODEL_TASKS=
# MODEL_FILES=
# MODEL_COMMS=
# OBSERVATIONAL_MEMORY_MODEL=
# DEFAULT_MODEL=

# === Scope Guard (on by default) ===
# Every domain agent aborts out-of-scope input before the LLM runs (root AGENTS.md gotcha #7).
# SCOPE_GUARD=off          # disable hard scope enforcement (not recommended)
# SCOPE_GUARD_MODEL=       # cheaper classifier model override (falls back to MODEL > DEFAULT_MODEL)

# --- Guardrails (spec 06) — all optional; zero config = deterministic slots only, LLM detectors inert without a provider key
# off = scope guard alone; log = detectors warn-only (false-positive safety, NOT outage safety); unset = active
#SECURITY_PROCESSORS=
#SECURITY_MODEL=            # guard-model for injection/PII detectors (default: SCOPE_GUARD_MODEL > MODEL > DEFAULT_MODEL)
#PI_THRESHOLD=0.8           # injection confidence 0-1 (docs default 0.7; raised vs false positives)
#TOKEN_LIMIT=8000           # TokenLimiter input budget per agent
#RESPONSE_CACHE=off         # unset = on; off removes the cache slot (never mounted for file-operations)
#RESPONSE_CACHE_TTL=300     # seconds
#COST_LIMIT_USD=            # opt-in TokenCostControl — REQUIRES observability storage (throws at registration without it)
#REVIEW_APPROVAL=off        # off = deep-research publishes without human review (⚠ banner)
#FILE_JAIL=off              # off = workspace containment disabled (⚠ banner); approvals assume jail ON
#WORKSPACE_ROOT=./workspace # jail root, resolved against process CWD (dev CWD = src/mastra/public/ — set absolute in prod)

# === Storage (optional — defaults to LibSQL file:./mastra.db) ===
# PostgreSQL (recommended for production, required for pgvector/RAG):
# DATABASE_URL=postgresql://user:password@localhost:5432/mastra
# Custom LibSQL location (used only when DATABASE_URL is not set):
# LIBSQL_URL=file:./mastra.db

# === Vectors / Semantic recall / RAG (all optional — see docs/adr/006-vectors-embeddings.md) ===
# Embedder: unset → local fastembed multilingual-E5 (1024d, no API keys, Spanish-friendly).
# Set to 'provider/model' to use a hosted embedder (requires that provider's key):
# EMBEDDING_MODEL=openai/text-embedding-3-small
# Master kill-switch for recall + knowledge tools (degrades to plain history, never crashes):
# SEMANTIC_RECALL=off
# Vector store is NOT configured here — it follows DATABASE_URL / LIBSQL_URL exactly like storage.
# Rerank: OFF by default (needs an LLM per search); opt-in via EMBEDDING_RERANK_MODEL is an open question (Phase 4 docs).

# === Docker Compose database settings (used by docker/*.yml) ===
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mastra
DB_USER=mastra_user

# === Observability (enabled by default; traces go to configured storage) ===
# ENABLE_OBSERVABILITY=false
ENABLE_TRACING=true
LOG_LEVEL=info
SERVICE_NAME=mastra-boilerplate

# === Mastra Platform (optional) ===
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=
MASTRA_ORG_ID=

# === Server Configuration ===
MASTRA_HOST=0.0.0.0
MASTRA_PORT=4111

# === Auth (Server & Studio) — docs/adr/004-auth-server-studio.md ===
MASTRA_JWT_SECRET=            # set in prod: protects /api/* + Studio login
AUTH_DISABLED=false           # explicit opt-out of auth AND the prod fail-fast (never prod)
# AUTH_PROVIDER=clerk|supabase|auth0|workos|firebase|okta|better-auth|google  # extension point only → FATAL
# MASTRA_API_PREFIX=          # only if server.apiPrefix is ever customized

# === PubSub / Workers (HA deployments) ===
# Distributed PubSub backend — REQUIRED for split workers and cross-process
# domain events (ADR-005). Unset = in-process EventEmitterPubSub (single process, dev default).
# REDIS_URL=redis://localhost:6379
# Which worker roles start in this process: false | orchestration | scheduler | backgroundTasks
# (comma-separated list allowed; scheduler must run in EXACTLY ONE process)
# Unset = in-process workers auto-start when needed — a workflow with a declared
# `schedule` (daily-digest → row wf_daily-digest) fires from the in-process scheduler.
# false = ALL workers off: scheduled workflows register but NEVER fire.
# Split topology (spec 02): run EXACTLY ONE MASTRA_WORKERS=scheduler + REDIS_URL,
# never alongside the in-process scheduler.
#MASTRA_WORKERS=
# Internal API base the orchestration worker calls to execute steps (split deployments only):
MASTRA_STEP_EXECUTION_URL=
# Bearer token the orchestration worker presents to the step-execution endpoint (spec 01):
# MASTRA_WORKER_AUTH_TOKEN=

# === MCP — consume & expose (docs/adr/007-mcp-as-integration-boundary.md) ===
# INBOUND: one JSON env var registers external MCP servers; agents routing key
# ("agents": ["<registry-key>"]) decides which agent gets which server's tools.
# ${VAR} interpolation works inside env / requestInit.headers (unset VAR = boot error).
# Security notes: stdio entries WITHOUT "inheritDefaultEnv": false leak a banner warn
# (subprocess env not isolated — never interpolate DEEPINFRA_API_KEY-class secrets into
# third-party servers); url+requestInit.headers can silently lose auth on legacy-SSE
# fallback — add "allowedHosts" and "requireToolApproval": true for remote servers.
# Mutating tool names (write|edit|delete|remove|drop|create|update, camelCase included)
# require human approval by default; tool responses/descriptions are UNTRUSTED model input
# until Spec 06's detector ships — treat MCP as a dev-local trust boundary.
# MCP_SERVERS='{"wikipedia":{"command":"npx","args":["-y","wikipedia-mcp"],"inheritDefaultEnv":false,"agents":["research"]},"weather":{"url":"https://weather.example.com/mcp","requestInit":{"headers":{"Authorization":"Bearer ${WEATHER_API_KEY}"}},"allowedHosts":["weather.example.com"],"requireToolApproval":true}}'
# OUTBOUND: read-only server (research+comms agents, file-read tool) at
# /api/mcp/boilerplate/mcp + stdio via `npm run mcp:stdio`. Requires Spec 01 auth
# outside localhost. Unset or anything but 'true' = off.
# ENABLE_MCP_SERVER=true

# === CORS (if needed) ===
CORS_ORIGIN=http://localhost:3000

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
